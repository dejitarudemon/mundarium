# LLM Studio (OpenAI-compatible) — required for root Invoke integration tests.
# Copy to .env and adjust. Tests skip when .env is missing.

# Base URL including /v1 (used by the OpenAI client for chat completions).
TEST_LLM_STUDIO_URL=http://localhost:1234/v1

# Model id as listed by LLM Studio /v1/models.
TEST_LLM_STUDIO_MODEL=local-model

# API key; LLM Studio often accepts any non-empty value.
TEST_LLM_STUDIO_API_KEY=lm-studio

# Max tool-call iterations for one Invoke.
TEST_LLM_STUDIO_MAX_ITERS=8

# Optional Invoke timeout (seconds). Default: 120.
TEST_LLM_STUDIO_TIMEOUT_SEC=120
