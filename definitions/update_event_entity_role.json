    "parameters": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "description": "Entity UUID."
        },
        "event_id": {
          "type": "string",
          "description": "Event UUID."
        },
        "role": {
          "type": "string",
          "enum": ["unknown", "actor", "participant", "affected", "witness", "informed"],
          "description": "New role."
        }
      },
      "required": ["entity_id", "event_id", "role"],
      "additionalProperties": false
    }
}
